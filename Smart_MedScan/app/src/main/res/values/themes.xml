<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Smart_MedScan" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>

        <!-- Màu chủ đạo của app (Xanh y tế) -->
        <item name="colorPrimary">#104DE0</item>
    </style>

    <style name="Theme.Smart_MedScan" parent="Base.Theme.Smart_MedScan" />

    <!-- Fix lỗi 2: Đổi parent sang Widget.Material3.BottomNavigationView -->
    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <!-- Màu nền của toàn bộ thanh menu -->
        <item name="containerColor">#FFFFFF</item>
        <!-- Style cho cái ô chọn (Indicator) -->
        <item name="itemActiveIndicatorStyle">@style/App.CustomIndicator</item>
        <!-- Màu icon và chữ khi được chọn/không được chọn -->
        <item name="itemIconTint">@color/nav_item_color_state</item>
        <item name="itemTextColor">@color/nav_item_color_state</item>
    </style>

    <!-- Biến ô vuông xám thành hình "Viên thuốc" bo tròn xanh nhạt -->
    <style name="App.CustomIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#E0E7FF</item> <!-- Màu xanh nhạt sạch sẽ -->
        <item name="android:width">56dp</item>
        <item name="android:height">32dp</item>
        <!-- Quan trọng: Dùng ShapeAppearance để bo tròn hoàn hảo -->
        <item name="marginHorizontal">12dp</item>
    </style>

    <!-- Định nghĩa hình dạng tròn cho nút Scan -->
    <style name="ShapeAppearance.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>